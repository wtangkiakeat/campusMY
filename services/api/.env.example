CAMPUSMY_ENVIRONMENT=development
CAMPUSMY_DATABASE_URL=sqlite:///./.runtime/campusmy.db
# For Supabase use postgresql+psycopg://... with TLS and a dedicated runtime role.
# CAMPUSMY_DATABASE_SCHEMA=campusmy
CAMPUSMY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CAMPUSMY_SUPABASE_URL=
CAMPUSMY_JWT_AUDIENCE=authenticated
# Optional exact issuer override; default is <SUPABASE_URL>/auth/v1.
CAMPUSMY_JWT_ISSUER=
# Generate at least 32 random bytes for university verification HMACs.
CAMPUSMY_OTP_SECRET=
CAMPUSMY_SMTP_HOST=
CAMPUSMY_SMTP_PORT=587
CAMPUSMY_SMTP_USERNAME=
CAMPUSMY_SMTP_PASSWORD=
CAMPUSMY_SMTP_FROM=
CAMPUSMY_SMTP_STARTTLS=true
CAMPUSMY_CREATE_TABLES=false
